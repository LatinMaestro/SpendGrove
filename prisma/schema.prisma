generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum AuthProvider {
  CLERK
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionSource {
  MANUAL
  IMPORTED
}

enum TransactionStatus {
  ACTIVE
  NEEDS_REVIEW
  DELETED
}

enum SplitRole {
  NONE
  PARENT
  CHILD
}

enum ImportType {
  TRANSACTION_CSV
  LOAN_CSV
}

enum ImportBatchStatus {
  CREATED
  SCANNING
  MAPPING_REQUIRED
  REVIEW_READY
  REVIEWING
  CONFIRMING
  COMPLETED
  CANCELLED
  FAILED
}

enum ImportRowAction {
  UNDECIDED
  IMPORT
  SKIP
  MERGE
}

enum ImportRowStatus {
  NEEDS_REVIEW
  READY
  WARNING
  COMMITTED
  SKIPPED
  MERGED
  FAILED
}

enum CategoryType {
  INCOME
  EXPENSE
  TRANSFER
}

enum MerchantRuleType {
  EXACT
  CONTAINS
  STARTS_WITH
  REGEX
}

enum AuditEntityType {
  USER
  SETTINGS
  CATEGORY
  TRANSACTION
  IMPORT_BATCH
  IMPORT_ROW
  BANK_IMPORT_PROFILE
  MERCHANT_PROFILE
  MERCHANT_ALIAS
  MERCHANT_RULE
  PROPERTY
  LOAN_ACCOUNT
  LOAN_REPAYMENT
  LOAN_RECONCILIATION_LINK
  RECURRING_ITEM
  RECURRING_SUGGESTION_DISMISSAL
  CATEGORY_BUDGET
  BULK_OPERATION
  TRANSFER_LINK
  IMPORT_UNDO_OPERATION
  RECURRING_INSTANCE
  SAVINGS_GOAL
  SAVINGS_GOAL_CONTRIBUTION
  NET_WORTH_ITEM
  NET_WORTH_VALUATION
  NET_WORTH_SNAPSHOT
  REMINDER_PREFERENCE
  REMINDER
  HOUSEHOLD
  HOUSEHOLD_MEMBERSHIP
  HOUSEHOLD_INVITATION
  HOUSEHOLD_RECORD_SHARE
  ACCOUNTANT_ACCESS_GRANT
  ACCOUNTANT_ACCESS_SCOPE
  DOCUMENT
  DOCUMENT_LINK
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED
  ARCHIVED
  DEACTIVATED
  IMPORTED
  SKIPPED
  MERGED
  REVIEWED
  PRIVACY_FIELDS_EXCLUDED
}

enum PropertyUsage {
  OWNER_OCCUPIED
  INVESTMENT
  OTHER
}

enum LoanPurpose {
  OWNER_OCCUPIER
  INVESTMENT
  PERSONAL
  OTHER
}

enum LoanType {
  HOME_LOAN
  CAR_LOAN
  PERSONAL_LOAN
  OTHER
}

enum LoanRepaymentSource {
  MANUAL
  LOAN_CSV
}

enum LoanReconciliationStatus {
  UNMATCHED
  NEEDS_REVIEW
  LINKED
}

enum LoanReconciliationConfidence {
  HIGH
  MEDIUM
  MANUAL
}

enum LoanReconciliationLinkMethod {
  SUGGESTED
  MANUAL
}

enum LoanReconciliationReason {
  EXACT_AMOUNT_NEAR_DATE
  ROUNDING_VARIANCE
  EXACT_AMOUNT_DELAYED_DATE
  MANUAL_OVERRIDE
}

enum PropertyRecordClassification {
  PROPERTY_INCOME
  PROPERTY_OUTGOING
  REFUND_OR_REVERSAL
  LOAN_PAYMENT_CONTEXT
  TRANSFER_CONTEXT
  OTHER_PROPERTY_RECORD
  EXCLUDED
}

enum RecurringCadence {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  OTHER
}

enum RecurringItemStatus {
  ACTIVE
  PAUSED
  CANCELLED
  UNKNOWN
  NEEDS_REVIEW
  ARCHIVED
}

enum BudgetPeriod {
  MONTHLY
}

enum BudgetStatus {
  ACTIVE
  ARCHIVED
}

enum RecurringItemSource {
  MANUAL
  CONFIRMED_SUGGESTION
}

enum RecurringDetectionConfidence {
  USER_CONFIRMED
  CLEAR_PATTERN
  REVIEW_PATTERN
}

enum SavingsGoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum NetWorthItemKind {
  ASSET
  LIABILITY
}

enum NetWorthItemCategory {
  CASH
  PROPERTY
  INVESTMENT
  SUPERANNUATION
  VEHICLE
  OTHER_ASSET
  HOME_LOAN
  PERSONAL_LOAN
  CREDIT_CARD
  OTHER_LIABILITY
}

enum NetWorthItemStatus {
  ACTIVE
  ARCHIVED
}

enum ReminderFamily {
  RECURRING_EXPECTED_DATE
  BUDGET_EIGHTY_PERCENT
  BUDGET_FULL
  IMPORT
  SAVINGS_GOAL
  UNMATCHED_LOAN
  EOFY_PREPARATION
}

enum ReminderStatus {
  ACTIVE
  ACKNOWLEDGED
  DISMISSED
  ARCHIVED
}

enum HouseholdStatus {
  ACTIVE
  ARCHIVED
}

enum HouseholdRole {
  ADMIN
  MEMBER
}

enum HouseholdMembershipStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum CollaborationInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum HouseholdShareEntityType {
  TRANSACTION
  PROPERTY
  LOAN_ACCOUNT
  CATEGORY_BUDGET
  RECURRING_ITEM
  SAVINGS_GOAL
  NET_WORTH_SNAPSHOT
  REPORT
}

enum AccountantGrantStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}

enum AccountantScopeType {
  REPORT
  TRANSACTION
  PROPERTY
  LOAN_ACCOUNT
  CATEGORY_BUDGET
  RECURRING_ITEM
  SAVINGS_GOAL
  NET_WORTH_SNAPSHOT
}

enum DocumentStatus {
  PENDING_UPLOAD
  QUARANTINED
  AVAILABLE
  FAILED
  DELETED
}

enum DocumentCategory {
  RECEIPT
  INVOICE
  LOAN_STATEMENT
  PROPERTY_RECORD
  REPORT_EVIDENCE
  OTHER
}

enum DocumentLinkTargetType {
  TRANSACTION
  PROPERTY
  LOAN_ACCOUNT
  LOAN_REPAYMENT
  IMPORT_BATCH
  REPORT
  FINANCIAL_YEAR
}

enum ImportUndoOperationStatus {
  RUNNING
  UNDONE
  PARTIAL
  FAILED
  RESTORING
  RESTORED
  PARTIALLY_RESTORED
}

enum ImportUndoItemStatus {
  PENDING
  UNDONE
  NO_CHANGE
  BLOCKED
  FAILED
  RESTORED
  RESTORE_BLOCKED
}

enum ImportUndoReason {
  SKIPPED_ROW
  MERGED_ROW_NO_CHANGE
  EXISTING_BATCH_UNSUPPORTED
  TRANSACTION_NOT_ACTIVE
  TRANSACTION_CHANGED
  SPLIT_CHANGED
  ACTIVE_LOAN_RECONCILIATION
  ACTIVE_TRANSFER_LINK
  PROPERTY_STATE_CHANGED
  PROPERTY_REVIEW_EXISTS
  BULK_OPERATION_DEPENDENCY
  OWNERSHIP_OR_LINK_MISMATCH
  RESTORE_STATE_CHANGED
  UNEXPECTED_SAFE_FAILURE
}

enum BulkOperationType {
  SET_CATEGORY
  APPLY_MERCHANT_CATEGORY
  LINK_PROPERTY
  UNLINK_PROPERTY
}

enum BulkOperationStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  REVERTED
  PARTIALLY_REVERTED
}

enum BulkOperationItemStatus {
  APPLIED
  SKIPPED
  FAILED
  REVERTED
  UNDO_BLOCKED
}

enum BulkOperationReason {
  ALREADY_APPLIED
  ALREADY_LINKED_TO_PROPERTY
  ALREADY_LINKED_TO_ANOTHER_PROPERTY
  CATEGORY_INCOMPATIBLE
  CATEGORY_UNAVAILABLE
  PROPERTY_UNAVAILABLE
  NOT_ACTIVE
  SPLIT_PARENT
  DIRECTION_NEEDS_CORRECTION
  MERCHANT_IDENTITY_MISMATCH
  STALE_RECORD
  NOT_FOUND_OR_NOT_OWNED
  UNEXPECTED_SAFE_FAILURE
}

model User {
  id                 String        @id @default(cuid())
  authProvider       AuthProvider?
  authProviderUserId String?
  email              String?       @unique
  name               String?
  status             UserStatus    @default(ACTIVE)
  country            String        @default("AU")
  timezone           String        @default("Australia/Brisbane")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  settings                     UserSettings?
  categories                   Category[]
  transactions                 Transaction[]
  importBatches                ImportBatch[]
  importRows                   ImportRow[]
  bankImportProfiles           BankImportProfile[]
  merchantProfiles             MerchantProfile[]
  merchantAliases              MerchantAlias[]
  merchantRules                MerchantRule[]
  properties                   Property[]
  loanAccounts                 LoanAccount[]
  loanRepayments               LoanRepayment[]
  loanReconciliationLinks      LoanReconciliationLink[]
  propertyTransactionLinks     PropertyTransactionLink[]
  propertyReportReviews        PropertyReportReview[]
  recurringItems               RecurringItem[]
  recurringSuggestionDismissals RecurringSuggestionDismissal[]
  categoryBudgets              CategoryBudget[]
  bulkOperations               BulkOperation[]
  bulkOperationItems           BulkOperationItem[]
  transferLinks                TransferLink[]
  importUndoOperations         ImportUndoOperation[]
  importUndoItems              ImportUndoItem[]
  recurringInstances           RecurringInstance[]
  savingsGoals                 SavingsGoal[]
  savingsGoalContributions     SavingsGoalContribution[]
  netWorthItems                NetWorthItem[]
  netWorthValuations           NetWorthValuation[]
  netWorthSnapshots            NetWorthSnapshot[]
  netWorthSnapshotEntries      NetWorthSnapshotEntry[]
  reminderPreferences          ReminderPreference[]
  reminders                    Reminder[]
  createdHouseholds            Household[]                 @relation("HouseholdCreator")
  householdMemberships         HouseholdMembership[]       @relation("HouseholdMember")
  householdInvitationsSent     HouseholdInvitation[]       @relation("HouseholdInviter")
  householdInvitationsAccepted HouseholdInvitation[]       @relation("HouseholdInvitationAcceptedUser")
  householdRecordSharesOwned   HouseholdRecordShare[]      @relation("HouseholdShareOwner")
  accountantGrantsOwned        AccountantAccessGrant[]     @relation("AccountantGrantOwner")
  accountantGrantsAccepted     AccountantAccessGrant[]     @relation("AccountantGrantAccountant")
  accountantScopesOwned        AccountantAccessScope[]     @relation("AccountantScopeOwner")
  documents                    Document[]
  documentLinks                DocumentLink[]
  auditEvents                  AuditEvent[]

  @@unique([authProvider, authProviderUserId])
}

model UserSettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  simpleMode              Boolean  @default(true)
  currency                String   @default("AUD")
  locale                  String   @default("en-AU")
  financialYearStartMonth Int      @default(7)
  featureFlags            Json     @default("{}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id         String       @id @default(cuid())
  userId     String
  name       String
  type       CategoryType
  parentId   String?
  colour     String?
  icon       String?
  isSeeded   Boolean      @default(false)
  isArchived Boolean      @default(false)
  deletedAt  DateTime?
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent           Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]        @relation("CategoryTree")
  transactions     Transaction[]     @relation("TransactionCategory")
  importRows       ImportRow[]       @relation("ImportRowCategory")
  merchantProfiles MerchantProfile[] @relation("MerchantDefaultCategory")
  merchantRules    MerchantRule[]    @relation("MerchantRuleCategory")
  recurringItems   RecurringItem[]
  categoryBudgets       CategoryBudget[]
  bulkTargetOperations BulkOperation[] @relation("BulkOperationTargetCategory")

  @@unique([userId, name, type])
  @@index([userId, type])
  @@index([userId, parentId])
  @@index([userId, isArchived, deletedAt])
}

model Transaction {
  id                           String            @id @default(cuid())
  userId                       String
  categoryId                   String?
  importBatchId                String?
  merchantProfileId            String?
  type                         TransactionType
  source                       TransactionSource
  status                       TransactionStatus @default(ACTIVE)
  splitRole                    SplitRole         @default(NONE)
  parentTransactionId          String?
  amountCents                  Int
  date                         DateTime
  description                  String
  importedDescriptionSanitized String?
  merchantName                 String?
  notes                        String?
  csvMatchHint                 Boolean           @default(false)
  importFingerprint            String?
  duplicateKey                 String?
  reviewedAt                   DateTime?
  deletedAt                    DateTime?
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category                Category?                @relation("TransactionCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  importBatch             ImportBatch?             @relation("ImportBatchTransactions", fields: [importBatchId], references: [id], onDelete: SetNull)
  merchantProfile         MerchantProfile?         @relation("TransactionMerchantProfile", fields: [merchantProfileId], references: [id], onDelete: SetNull)
  parentTransaction       Transaction?             @relation("TransactionSplits", fields: [parentTransactionId], references: [id], onDelete: SetNull)
  splitChildren           Transaction[]            @relation("TransactionSplits")
  importRowsMatched       ImportRow[]              @relation("ImportRowMatchedTransaction")
  importRowsCommitted     ImportRow[]              @relation("ImportRowCommittedTransaction")
  loanReconciliationLinks LoanReconciliationLink[]
  propertyLink            PropertyTransactionLink?
  propertyReportReview    PropertyReportReview?
  bulkOperationItems       BulkOperationItem[]
  outgoingTransferLinks    TransferLink[]            @relation("OutgoingTransferTransaction")
  incomingTransferLinks    TransferLink[]            @relation("IncomingTransferTransaction")
  importUndoItems          ImportUndoItem[]
  recurringInstance       RecurringInstance?

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, importBatchId])
  @@index([userId, merchantProfileId])
  @@index([userId, parentTransactionId])
  @@index([userId, importFingerprint])
  @@index([userId, duplicateKey])
  @@index([userId, deletedAt])
}

model ImportBatch {
  id                       String            @id @default(cuid())
  userId                   String
  type                     ImportType        @default(TRANSACTION_CSV)
  status                   ImportBatchStatus @default(CREATED)
  bankImportProfileId      String?
  safeFileName             String?
  originalFileNameRedacted String?
  fileNameHash             String?
  fileSizeBytes            Int?
  rowCount                 Int               @default(0)
  parsedRowCount           Int               @default(0)
  privateFieldCount        Int               @default(0)
  importedCount            Int               @default(0)
  skippedCount             Int               @default(0)
  mergedCount              Int               @default(0)
  detectedBankName         String?
  detectedAccountType      String?
  mappingSummary           Json?
  excludedPrivateHeaders   String[]          @default([])
  warningCodes             String[]          @default([])
  createdAt                DateTime          @default(now())
  completedAt              DateTime?
  deletedAt                DateTime?
  updatedAt                DateTime          @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankImportProfile BankImportProfile? @relation("BankImportProfileBatches", fields: [bankImportProfileId], references: [id], onDelete: SetNull)
  transactions      Transaction[]      @relation("ImportBatchTransactions")
  importRows        ImportRow[]
  loanRepayments    LoanRepayment[]
  undoOperation     ImportUndoOperation?

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([userId, fileNameHash])
  @@index([userId, deletedAt])
}

model ImportRow {
  id                     String          @id @default(cuid())
  userId                 String
  importBatchId          String
  rowNumber              Int
  action                 ImportRowAction @default(UNDECIDED)
  status                 ImportRowStatus @default(NEEDS_REVIEW)
  mappedDate             DateTime?
  amountCents            Int?
  description            String?
  merchantName           String?
  categoryId             String?
  matchedTransactionId   String?
  committedTransactionId        String?
  committedTransactionUpdatedAt DateTime?
  warningCodes           String[]        @default([])
  metadata               Json?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  importBatch          ImportBatch  @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  category             Category?    @relation("ImportRowCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  matchedTransaction   Transaction? @relation("ImportRowMatchedTransaction", fields: [matchedTransactionId], references: [id], onDelete: SetNull)
  committedTransaction Transaction? @relation("ImportRowCommittedTransaction", fields: [committedTransactionId], references: [id], onDelete: SetNull)
  undoItems            ImportUndoItem[]

  @@unique([importBatchId, rowNumber])
  @@index([userId, importBatchId])
  @@index([userId, status])
  @@index([userId, action])
  @@index([userId, matchedTransactionId])
}

model BankImportProfile {
  id                    String   @id @default(cuid())
  userId                String
  displayName           String
  bankName              String?
  accountType           String?
  hasHeader             Boolean  @default(true)
  dateFormats           String[] @default([])
  columnMapping         Json
  ignoredHeaders        String[] @default([])
  privateHeaderPatterns String[] @default([])
  confidence            Int      @default(0)
  isUserConfirmed       Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  importBatches ImportBatch[] @relation("BankImportProfileBatches")

  @@unique([userId, displayName])
  @@index([userId, bankName])
}

model MerchantProfile {
  id                String    @id @default(cuid())
  userId            String
  name              String
  normalizedName    String
  defaultCategoryId String?
  isActive          Boolean   @default(true)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultCategory Category?       @relation("MerchantDefaultCategory", fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  aliases         MerchantAlias[] @relation("MerchantProfileAliases")
  rules           MerchantRule[]  @relation("MerchantProfileRules")
  transactions    Transaction[]   @relation("TransactionMerchantProfile")

  @@unique([userId, normalizedName])
  @@index([userId, defaultCategoryId])
  @@index([userId, isActive, deletedAt])
}

model MerchantAlias {
  id                String    @id @default(cuid())
  userId            String
  merchantProfileId String
  aliasName         String
  normalizedAlias   String
  isActive          Boolean   @default(true)
  deactivatedAt     DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantProfile MerchantProfile @relation("MerchantProfileAliases", fields: [merchantProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedAlias])
  @@index([userId, merchantProfileId])
  @@index([userId, normalizedAlias])
  @@index([userId, isActive, deletedAt])
}

model MerchantRule {
  id                String           @id @default(cuid())
  userId            String
  merchantProfileId String?
  categoryId        String?
  type              MerchantRuleType
  pattern           String
  normalizedPattern String
  priority          Int              @default(100)
  isActive          Boolean          @default(true)
  deactivatedAt     DateTime?
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantProfile MerchantProfile? @relation("MerchantProfileRules", fields: [merchantProfileId], references: [id], onDelete: SetNull)
  category        Category?        @relation("MerchantRuleCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, type, isActive])
  @@index([userId, merchantProfileId])
  @@index([userId, categoryId])
  @@index([userId, normalizedPattern])
  @@index([userId, deletedAt])
}

model AuditEvent {
  id         String          @id @default(cuid())
  userId     String
  entityType AuditEntityType
  entityId   String?
  action     AuditAction
  metadata   Json?
  createdAt  DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, entityType, entityId])
}

model Property {
  id         String        @id @default(cuid())
  userId     String
  nickname   String
  usage      PropertyUsage
  isArchived Boolean       @default(false)
  archivedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanAccounts     LoanAccount[]
  transactionLinks PropertyTransactionLink[]
  reportReviews         PropertyReportReview[]
  bulkTargetOperations BulkOperation[] @relation("BulkOperationTargetProperty")
  netWorthItems        NetWorthItem[]

  @@unique([userId, nickname])
  @@index([userId, usage])
  @@index([userId, isArchived, deletedAt])
}

model LoanAccount {
  id                  String      @id @default(cuid())
  userId              String
  propertyId          String?
  nickname            String
  lenderName          String?
  purpose             LoanPurpose
  type                LoanType
  currentBalanceCents Int?
  balanceAsOf         DateTime?
  isArchived          Boolean     @default(false)
  archivedAt          DateTime?
  deletedAt           DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  repayments    LoanRepayment[]
  netWorthItems NetWorthItem[]

  @@unique([userId, nickname])
  @@index([userId, propertyId])
  @@index([userId, purpose, type])
  @@index([userId, isArchived, deletedAt])
}

model LoanRepayment {
  id                   String                   @id @default(cuid())
  userId               String
  loanAccountId        String
  importBatchId        String?
  repaymentDate        DateTime
  totalPaymentCents    Int
  principalCents       Int?
  interestCents        Int?
  feeCents             Int?
  balanceAfterCents    Int?
  source               LoanRepaymentSource
  reconciliationStatus LoanReconciliationStatus @default(UNMATCHED)
  isArchived           Boolean                  @default(false)
  archivedAt           DateTime?
  deletedAt            DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanAccount        LoanAccount             @relation(fields: [loanAccountId], references: [id], onDelete: Restrict)
  importBatch        ImportBatch?            @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  reconciliationLink LoanReconciliationLink?

  @@index([userId, loanAccountId, repaymentDate])
  @@index([userId, importBatchId])
  @@index([userId, reconciliationStatus])
  @@index([userId, isArchived, deletedAt])
}

model LoanReconciliationLink {
  id                  String                       @id @default(cuid())
  userId              String
  loanRepaymentId     String                       @unique
  transactionId       String
  confidence          LoanReconciliationConfidence
  amountVarianceCents Int
  dateDifferenceDays  Int
  method              LoanReconciliationLinkMethod
  reason              LoanReconciliationReason
  unlinkedAt          DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanRepayment LoanRepayment @relation(fields: [loanRepaymentId], references: [id], onDelete: Restrict)
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([userId, transactionId])
  @@index([userId, unlinkedAt])
}

model PropertyTransactionLink {
  id            String    @id @default(cuid())
  userId        String
  transactionId String    @unique
  propertyId    String
  unlinkedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@index([userId, propertyId, unlinkedAt])
  @@index([userId, unlinkedAt])
}

model PropertyReportReview {
  id             String                       @id @default(cuid())
  userId         String
  propertyId     String
  transactionId  String                       @unique
  classification PropertyRecordClassification
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([userId, propertyId, classification])
  @@index([userId, classification])
}

model RecurringItem {
  id                         String                         @id @default(cuid())
  userId                     String
  categoryId                 String?
  label                      String
  transactionType            TransactionType
  expectedAmountCents        Int?
  expectedAmountMinCents     Int?
  expectedAmountMaxCents     Int?
  cadence                    RecurringCadence
  nextExpectedDate           DateTime?
  source                     RecurringItemSource?
  detectionConfidence        RecurringDetectionConfidence?
  status                     RecurringItemStatus            @default(ACTIVE)
  archivedAt                 DateTime?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  instances RecurringInstance[]

  @@index([userId, status])
  @@index([userId, categoryId])
  @@index([userId, cadence])
  @@index([userId, source])
}

model RecurringSuggestionDismissal {
  id            String   @id @default(cuid())
  userId        String
  suggestionKey String
  dismissedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, suggestionKey])
  @@index([userId, dismissedAt])
}

model CategoryBudget {
  id          String       @id @default(cuid())
  userId      String
  categoryId  String
  amountCents Int
  period      BudgetPeriod @default(MONTHLY)
  status      BudgetStatus @default(ACTIVE)
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, categoryId])
  @@index([userId, period, status])
  @@index([userId, categoryId, period, status])
}



model RecurringInstance {
  id              String    @id @default(cuid())
  userId          String
  recurringItemId String
  transactionId   String    @unique
  linkedAt        DateTime  @default(now())
  unlinkedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringItem RecurringItem @relation(fields: [recurringItemId], references: [id], onDelete: Cascade)
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([userId, recurringItemId, unlinkedAt])
  @@index([userId, transactionId, unlinkedAt])
}

model SavingsGoal {
  id                   String            @id @default(cuid())
  userId               String
  name                 String
  targetAmountCents    Int
  targetDate           DateTime?
  openingProgressCents Int               @default(0)
  status               SavingsGoalStatus @default(ACTIVE)
  completedAt          DateTime?
  archivedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingsGoalContribution[]

  @@unique([userId, name])
  @@index([userId, status, targetDate])
}

model SavingsGoalContribution {
  id               String    @id @default(cuid())
  userId           String
  savingsGoalId    String
  amountCents      Int
  contributionDate DateTime
  note             String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  savingsGoal SavingsGoal @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)

  @@index([userId, savingsGoalId, contributionDate])
  @@index([userId, deletedAt])
}

model NetWorthItem {
  id            String               @id @default(cuid())
  userId        String
  propertyId    String?
  loanAccountId String?
  name          String
  kind          NetWorthItemKind
  category      NetWorthItemCategory
  status        NetWorthItemStatus   @default(ACTIVE)
  archivedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  property        Property?               @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  loanAccount     LoanAccount?            @relation(fields: [loanAccountId], references: [id], onDelete: SetNull)
  valuations      NetWorthValuation[]
  snapshotEntries NetWorthSnapshotEntry[]

  @@unique([userId, name])
  @@unique([userId, propertyId])
  @@unique([userId, loanAccountId])
  @@index([userId, kind, status])
  @@index([userId, category, status])
}

model NetWorthValuation {
  id             String    @id @default(cuid())
  userId         String
  netWorthItemId String
  valueCents     Int
  valuationDate  DateTime
  note           String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  netWorthItem NetWorthItem @relation(fields: [netWorthItemId], references: [id], onDelete: Cascade)

  @@unique([netWorthItemId, valuationDate])
  @@index([userId, valuationDate])
  @@index([userId, deletedAt])
}

model NetWorthSnapshot {
  id                  String    @id @default(cuid())
  userId              String
  snapshotDate        DateTime
  totalAssetCents     Int
  totalLiabilityCents Int
  netWorthCents       Int
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries NetWorthSnapshotEntry[]

  @@unique([userId, snapshotDate])
  @@index([userId, archivedAt, snapshotDate])
}

model NetWorthSnapshotEntry {
  id               String               @id @default(cuid())
  userId           String
  snapshotId       String
  netWorthItemId   String
  itemName         String
  kind             NetWorthItemKind
  category         NetWorthItemCategory
  valueCents       Int
  valuationDate    DateTime
  createdAt        DateTime             @default(now())

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshot     NetWorthSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  netWorthItem NetWorthItem     @relation(fields: [netWorthItemId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, netWorthItemId])
  @@index([userId, snapshotId])
}

model ReminderPreference {
  id               String         @id @default(cuid())
  userId           String
  family           ReminderFamily
  isEnabled        Boolean        @default(false)
  leadDays         Int            @default(0)
  thresholdPercent Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, family])
  @@index([userId, isEnabled])
}

model Reminder {
  id             String         @id @default(cuid())
  userId         String
  family         ReminderFamily
  sourceEntityId String?
  dedupeKey      String
  dueDate        DateTime
  status         ReminderStatus @default(ACTIVE)
  acknowledgedAt DateTime?
  dismissedAt    DateTime?
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, status, dueDate])
  @@index([userId, family, status])
}


model Household {
  id            String          @id @default(cuid())
  creatorUserId String
  name          String
  status        HouseholdStatus @default(ACTIVE)
  archivedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  creator     User                    @relation("HouseholdCreator", fields: [creatorUserId], references: [id], onDelete: Restrict)
  memberships HouseholdMembership[]
  invitations HouseholdInvitation[]
  shares      HouseholdRecordShare[]

  @@index([creatorUserId, status])
  @@index([status, createdAt])
}

model HouseholdMembership {
  id          String                    @id @default(cuid())
  householdId String
  userId      String
  role        HouseholdRole
  status      HouseholdMembershipStatus @default(ACTIVE)
  joinedAt    DateTime                  @default(now())
  endedAt     DateTime?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation("HouseholdMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId, status])
  @@index([householdId, role, status])
}

model HouseholdInvitation {
  id                   String                        @id @default(cuid())
  householdId          String
  inviterUserId        String
  acceptedUserId       String?
  intendedIdentityHash String?
  tokenHash            String                        @unique
  role                 HouseholdRole
  status               CollaborationInvitationStatus @default(PENDING)
  expiresAt            DateTime
  acceptedAt           DateTime?
  revokedAt            DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  inviter     User      @relation("HouseholdInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  acceptedUser User?    @relation("HouseholdInvitationAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([householdId, status, expiresAt])
  @@index([inviterUserId, status, createdAt])
  @@index([acceptedUserId, status])
  @@index([intendedIdentityHash, status])
}

model HouseholdRecordShare {
  id          String                   @id @default(cuid())
  householdId String
  ownerUserId String
  entityType  HouseholdShareEntityType
  entityId    String
  sharedAt    DateTime                 @default(now())
  revokedAt   DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner     User      @relation("HouseholdShareOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([householdId, ownerUserId, entityType, entityId])
  @@index([householdId, revokedAt, entityType])
  @@index([ownerUserId, revokedAt, entityType])
}

model AccountantAccessGrant {
  id                   String                @id @default(cuid())
  ownerUserId          String
  accountantUserId     String?
  intendedIdentityHash String?
  tokenHash            String                @unique
  status               AccountantGrantStatus @default(PENDING)
  expiresAt            DateTime
  acceptedAt           DateTime?
  revokedAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  owner      User                    @relation("AccountantGrantOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  accountant User?                   @relation("AccountantGrantAccountant", fields: [accountantUserId], references: [id], onDelete: SetNull)
  scopes     AccountantAccessScope[]

  @@index([ownerUserId, status, expiresAt])
  @@index([accountantUserId, status, expiresAt])
  @@index([intendedIdentityHash, status])
}

model AccountantAccessScope {
  id          String              @id @default(cuid())
  grantId     String
  ownerUserId String
  scopeType   AccountantScopeType
  scopeKey    String
  entityId    String?
  sharedAt    DateTime            @default(now())
  revokedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  grant AccountantAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  owner User                  @relation("AccountantScopeOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([grantId, scopeType, scopeKey])
  @@index([ownerUserId, revokedAt, scopeType])
  @@index([grantId, revokedAt, scopeType])
}

model Document {
  id                String           @id @default(cuid())
  userId            String
  displayName       String
  category          DocumentCategory
  status            DocumentStatus   @default(PENDING_UPLOAD)
  contentType       String
  sizeBytes         Int
  checksumSha256    String?
  storageProvider   String?
  objectKey         String?
  documentDate      DateTime?
  financialYear     String?
  availableAt       DateTime?
  quarantinedAt     DateTime?
  failedAt          DateTime?
  deletedAt         DateTime?
  providerDeletedAt DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  links DocumentLink[]

  @@unique([storageProvider, objectKey])
  @@index([userId, status, createdAt])
  @@index([userId, category, deletedAt])
  @@index([userId, financialYear])
}

model DocumentLink {
  id             String                 @id @default(cuid())
  userId         String
  documentId     String
  targetType     DocumentLinkTargetType
  targetKey      String
  targetEntityId String?
  linkedAt       DateTime               @default(now())
  revokedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, targetType, targetKey])
  @@index([userId, revokedAt, targetType])
  @@index([documentId, revokedAt])
}

model BulkOperation {
  id               String              @id @default(cuid())
  userId           String
  type             BulkOperationType
  status           BulkOperationStatus @default(RUNNING)
  targetCategoryId String?
  targetPropertyId String?
  requestedCount   Int                 @default(0)
  appliedCount     Int                 @default(0)
  skippedCount     Int                 @default(0)
  failedCount      Int                 @default(0)
  undoBlockedCount Int                 @default(0)
  createdAt        DateTime            @default(now())
  completedAt      DateTime?
  undoExpiresAt    DateTime?
  revertedAt       DateTime?
  updatedAt        DateTime            @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetCategory Category?           @relation("BulkOperationTargetCategory", fields: [targetCategoryId], references: [id], onDelete: SetNull)
  targetProperty Property?           @relation("BulkOperationTargetProperty", fields: [targetPropertyId], references: [id], onDelete: SetNull)
  items          BulkOperationItem[]

  @@index([userId, status, createdAt])
  @@index([userId, type, createdAt])
  @@index([targetCategoryId])
  @@index([targetPropertyId])
}

model BulkOperationItem {
  id                          String                  @id @default(cuid())
  userId                      String
  operationId                 String
  transactionId               String
  status                      BulkOperationItemStatus
  reason                      BulkOperationReason?
  beforeCategoryId            String?
  afterCategoryId             String?
  beforePropertyId            String?
  afterPropertyId             String?
  beforeTransactionUpdatedAt  DateTime?
  appliedTransactionUpdatedAt DateTime?
  revertedAt                  DateTime?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation   BulkOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  transaction Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([operationId, transactionId])
  @@index([userId, status, createdAt])
  @@index([operationId, status])
  @@index([transactionId, createdAt])
}


model TransferLink {
  id                    String    @id @default(cuid())
  userId                String
  outgoingTransactionId String
  incomingTransactionId String
  confirmedAt           DateTime  @default(now())
  unlinkedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoingTransaction Transaction @relation("OutgoingTransferTransaction", fields: [outgoingTransactionId], references: [id], onDelete: Restrict)
  incomingTransaction Transaction @relation("IncomingTransferTransaction", fields: [incomingTransactionId], references: [id], onDelete: Restrict)

  @@index([userId, unlinkedAt, createdAt])
  @@index([userId, outgoingTransactionId, unlinkedAt])
  @@index([userId, incomingTransactionId, unlinkedAt])
}


model ImportUndoOperation {
  id                   String                    @id @default(cuid())
  userId               String
  importBatchId        String                    @unique
  status               ImportUndoOperationStatus @default(RUNNING)
  requestedCount       Int                       @default(0)
  undoneCount          Int                       @default(0)
  noChangeCount        Int                       @default(0)
  blockedCount         Int                       @default(0)
  failedCount          Int                       @default(0)
  restoredCount        Int                       @default(0)
  restoreBlockedCount  Int                       @default(0)
  createdAt            DateTime                  @default(now())
  completedAt          DateTime?
  restoredAt           DateTime?
  updatedAt            DateTime                  @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  importBatch ImportBatch      @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  items       ImportUndoItem[]

  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
}

model ImportUndoItem {
  id                         String               @id @default(cuid())
  userId                     String
  operationId                String
  importRowId                String
  transactionId              String?
  status                     ImportUndoItemStatus @default(PENDING)
  reason                     ImportUndoReason?
  beforeTransactionUpdatedAt DateTime?
  appliedTransactionUpdatedAt DateTime?
  undoneAt                   DateTime?
  restoredAt                 DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation   ImportUndoOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  importRow   ImportRow           @relation(fields: [importRowId], references: [id], onDelete: Restrict)
  transaction Transaction?        @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([operationId, importRowId])
  @@index([userId, status, createdAt])
  @@index([operationId, status])
  @@index([transactionId])
}
