generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionSource {
  MANUAL
  IMPORTED
}

enum TransactionStatus {
  ACTIVE
  NEEDS_REVIEW
  DELETED
}

enum SplitRole {
  NONE
  PARENT
  CHILD
}

enum ImportType {
  TRANSACTION_CSV
}

enum ImportBatchStatus {
  CREATED
  SCANNING
  MAPPING_REQUIRED
  REVIEW_READY
  REVIEWING
  CONFIRMING
  COMPLETED
  CANCELLED
  FAILED
}

enum ImportRowAction {
  UNDECIDED
  IMPORT
  SKIP
  MERGE
}

enum ImportRowStatus {
  NEEDS_REVIEW
  READY
  WARNING
  COMMITTED
  SKIPPED
  MERGED
  FAILED
}

enum CategoryType {
  INCOME
  EXPENSE
  TRANSFER
}

enum MerchantRuleType {
  EXACT
  CONTAINS
  STARTS_WITH
  REGEX
}

enum AuditEntityType {
  USER
  SETTINGS
  CATEGORY
  TRANSACTION
  IMPORT_BATCH
  IMPORT_ROW
  BANK_IMPORT_PROFILE
  MERCHANT_PROFILE
  MERCHANT_ALIAS
  MERCHANT_RULE
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED
  ARCHIVED
  DEACTIVATED
  IMPORTED
  SKIPPED
  MERGED
  REVIEWED
  PRIVACY_FIELDS_EXCLUDED
}

model User {
  id        String     @id @default(cuid())
  email     String?    @unique
  name      String?
  status    UserStatus @default(ACTIVE)
  country   String     @default("AU")
  timezone  String     @default("Australia/Brisbane")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  settings           UserSettings?
  categories         Category[]
  transactions       Transaction[]
  importBatches      ImportBatch[]
  importRows         ImportRow[]
  bankImportProfiles BankImportProfile[]
  merchantProfiles   MerchantProfile[]
  merchantAliases    MerchantAlias[]
  merchantRules      MerchantRule[]
  auditEvents        AuditEvent[]
}

model UserSettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  simpleMode              Boolean  @default(true)
  currency                String   @default("AUD")
  locale                  String   @default("en-AU")
  financialYearStartMonth Int      @default(7)
  featureFlags            Json     @default("{}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id         String       @id @default(cuid())
  userId     String
  name       String
  type       CategoryType
  parentId   String?
  colour     String?
  icon       String?
  isSeeded   Boolean      @default(false)
  isArchived Boolean      @default(false)
  deletedAt  DateTime?
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent           Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]        @relation("CategoryTree")
  transactions     Transaction[]     @relation("TransactionCategory")
  importRows       ImportRow[]       @relation("ImportRowCategory")
  merchantProfiles MerchantProfile[] @relation("MerchantDefaultCategory")
  merchantRules    MerchantRule[]    @relation("MerchantRuleCategory")

  @@index([userId, type])
  @@index([userId, parentId])
  @@index([userId, deletedAt])
  @@unique([userId, name, type])
}

model Transaction {
  id                String            @id @default(cuid())
  userId            String
  categoryId        String?
  importBatchId     String?
  merchantProfileId String?

  type      TransactionType
  source    TransactionSource
  status    TransactionStatus @default(ACTIVE)
  splitRole SplitRole         @default(NONE)

  parentTransactionId String?
  amountCents         Int
  date                DateTime

  description                  String
  importedDescriptionSanitized String?
  merchantName                 String?
  notes                        String?

  csvMatchHint      Boolean   @default(false)
  importFingerprint String?
  duplicateKey      String?
  reviewedAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          Category?        @relation("TransactionCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  importBatch       ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  merchantProfile   MerchantProfile? @relation("TransactionMerchantProfile", fields: [merchantProfileId], references: [id], onDelete: SetNull)
  parentTransaction Transaction?     @relation("TransactionSplits", fields: [parentTransactionId], references: [id], onDelete: SetNull)
  splitChildren     Transaction[]    @relation("TransactionSplits")

  importRowsMatched   ImportRow[] @relation("ImportRowMatchedTransaction")
  importRowsCommitted ImportRow[] @relation("ImportRowCommittedTransaction")

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, importBatchId])
  @@index([userId, importFingerprint])
  @@index([userId, duplicateKey])
  @@index([userId, deletedAt])
}

model ImportBatch {
  id                  String            @id @default(cuid())
  userId              String
  type                ImportType        @default(TRANSACTION_CSV)
  status              ImportBatchStatus @default(CREATED)
  bankImportProfileId String?

  safeFileName             String?
  originalFileNameRedacted String?
  fileNameHash             String?
  fileSizeBytes            Int?

  rowCount          Int @default(0)
  parsedRowCount    Int @default(0)
  privateFieldCount Int @default(0)
  importedCount     Int @default(0)
  skippedCount      Int @default(0)
  mergedCount       Int @default(0)

  detectedBankName       String?
  detectedAccountType    String?
  mappingSummary         Json?
  excludedPrivateHeaders String[]
  warningCodes           String[]

  createdAt   DateTime  @default(now())
  completedAt DateTime?
  deletedAt   DateTime?
  updatedAt   DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankImportProfile BankImportProfile? @relation(fields: [bankImportProfileId], references: [id], onDelete: SetNull)
  transactions      Transaction[]
  importRows        ImportRow[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([userId, deletedAt])
}

model ImportRow {
  id            String          @id @default(cuid())
  userId        String
  importBatchId String
  rowNumber     Int

  action ImportRowAction @default(UNDECIDED)
  status ImportRowStatus @default(NEEDS_REVIEW)

  mappedDate   DateTime?
  amountCents  Int?
  description  String?
  merchantName String?
  categoryId   String?

  matchedTransactionId   String?
  committedTransactionId String?

  warningCodes Json?
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  importBatch          ImportBatch  @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  category             Category?    @relation("ImportRowCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  matchedTransaction   Transaction? @relation("ImportRowMatchedTransaction", fields: [matchedTransactionId], references: [id], onDelete: SetNull)
  committedTransaction Transaction? @relation("ImportRowCommittedTransaction", fields: [committedTransactionId], references: [id], onDelete: SetNull)

  @@index([userId, importBatchId])
  @@index([userId, status])
  @@index([userId, action])
  @@unique([importBatchId, rowNumber])
}

model BankImportProfile {
  id                    String   @id @default(cuid())
  userId                String
  displayName           String
  bankName              String?
  accountType           String?
  hasHeader             Boolean  @default(true)
  dateFormats           String[]
  columnMapping         Json
  ignoredHeaders        String[]
  privateHeaderPatterns String[]
  confidence            Int      @default(0)
  isUserConfirmed       Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  importBatches ImportBatch[]

  @@index([userId, bankName])
  @@unique([userId, displayName])
}

model MerchantProfile {
  id                String   @id @default(cuid())
  userId            String
  name              String
  defaultCategoryId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultCategory Category?       @relation("MerchantDefaultCategory", fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  aliases         MerchantAlias[]
  rules           MerchantRule[]
  transactions    Transaction[]   @relation("TransactionMerchantProfile")

  @@unique([userId, name])
}

model MerchantAlias {
  id                String   @id @default(cuid())
  userId            String
  merchantProfileId String
  rawAlias          String
  normalizedAlias   String
  createdAt         DateTime @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantProfile MerchantProfile @relation(fields: [merchantProfileId], references: [id], onDelete: Cascade)

  @@index([userId, normalizedAlias])
  @@unique([userId, normalizedAlias])
}

model MerchantRule {
  id                String           @id @default(cuid())
  userId            String
  merchantProfileId String?
  categoryId        String?
  type              MerchantRuleType
  pattern           String
  normalizedPattern String
  priority          Int              @default(100)
  isActive          Boolean          @default(true)
  deactivatedAt     DateTime?
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantProfile MerchantProfile? @relation(fields: [merchantProfileId], references: [id], onDelete: SetNull)
  category        Category?        @relation("MerchantRuleCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, type, isActive])
  @@index([userId, normalizedPattern])
  @@index([userId, deletedAt])
}

model AuditEvent {
  id         String          @id @default(cuid())
  userId     String
  entityType AuditEntityType
  entityId   String?
  action     AuditAction
  metadata   Json?
  createdAt  DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, entityType, entityId])
}
