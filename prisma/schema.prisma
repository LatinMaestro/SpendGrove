generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum AuthProvider {
  CLERK
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionSource {
  MANUAL
  IMPORTED
}

enum TransactionStatus {
  ACTIVE
  NEEDS_REVIEW
  DELETED
}

enum SplitRole {
  NONE
  PARENT
  CHILD
}

enum ImportType {
  TRANSACTION_CSV
  LOAN_CSV
}

enum ImportBatchStatus {
  CREATED
  SCANNING
  MAPPING_REQUIRED
  REVIEW_READY
  REVIEWING
  CONFIRMING
  COMPLETED
  CANCELLED
  FAILED
}

enum ImportRowAction {
  UNDECIDED
  IMPORT
  SKIP
  MERGE
}

enum ImportRowStatus {
  NEEDS_REVIEW
  READY
  WARNING
  COMMITTED
  SKIPPED
  MERGED
  FAILED
}

enum CategoryType {
  INCOME
  EXPENSE
  TRANSFER
}

enum MerchantRuleType {
  EXACT
  CONTAINS
  STARTS_WITH
  REGEX
}

enum AuditEntityType {
  USER
  SETTINGS
  CATEGORY
  TRANSACTION
  IMPORT_BATCH
  IMPORT_ROW
  BANK_IMPORT_PROFILE
  MERCHANT_PROFILE
  MERCHANT_ALIAS
  MERCHANT_RULE
  PROPERTY
  LOAN_ACCOUNT
  LOAN_REPAYMENT
  LOAN_RECONCILIATION_LINK
  RECURRING_ITEM
  RECURRING_SUGGESTION_DISMISSAL
  CATEGORY_BUDGET
  BULK_OPERATION
  TRANSFER_LINK
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED
  ARCHIVED
  DEACTIVATED
  IMPORTED
  SKIPPED
  MERGED
  REVIEWED
  PRIVACY_FIELDS_EXCLUDED
}

enum PropertyUsage {
  OWNER_OCCUPIED
  INVESTMENT
  OTHER
}

enum LoanPurpose {
  OWNER_OCCUPIER
  INVESTMENT
  PERSONAL
  OTHER
}

enum LoanType {
  HOME_LOAN
  CAR_LOAN
  PERSONAL_LOAN
  OTHER
}

enum LoanRepaymentSource {
  MANUAL
  LOAN_CSV
}

enum LoanReconciliationStatus {
  UNMATCHED
  NEEDS_REVIEW
  LINKED
}

enum LoanReconciliationConfidence {
  HIGH
  MEDIUM
  MANUAL
}

enum LoanReconciliationLinkMethod {
  SUGGESTED
  MANUAL
}

enum LoanReconciliationReason {
  EXACT_AMOUNT_NEAR_DATE
  ROUNDING_VARIANCE
  EXACT_AMOUNT_DELAYED_DATE
  MANUAL_OVERRIDE
}

enum PropertyRecordClassification {
  PROPERTY_INCOME
  PROPERTY_OUTGOING
  REFUND_OR_REVERSAL
  LOAN_PAYMENT_CONTEXT
  TRANSFER_CONTEXT
  OTHER_PROPERTY_RECORD
  EXCLUDED
}

enum RecurringCadence {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  OTHER
}

enum RecurringItemStatus {
  ACTIVE
  ARCHIVED
}

enum BudgetPeriod {
  MONTHLY
}

enum BudgetStatus {
  ACTIVE
  ARCHIVED
}

enum BulkOperationType {
  SET_CATEGORY
  APPLY_MERCHANT_CATEGORY
  LINK_PROPERTY
  UNLINK_PROPERTY
}

enum BulkOperationStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  REVERTED
  PARTIALLY_REVERTED
}

enum BulkOperationItemStatus {
  APPLIED
  SKIPPED
  FAILED
  REVERTED
  UNDO_BLOCKED
}

enum BulkOperationReason {
  ALREADY_APPLIED
  ALREADY_LINKED_TO_PROPERTY
  ALREADY_LINKED_TO_ANOTHER_PROPERTY
  CATEGORY_INCOMPATIBLE
  CATEGORY_UNAVAILABLE
  PROPERTY_UNAVAILABLE
  NOT_ACTIVE
  SPLIT_PARENT
  DIRECTION_NEEDS_CORRECTION
  MERCHANT_IDENTITY_MISMATCH
  STALE_RECORD
  NOT_FOUND_OR_NOT_OWNED
  UNEXPECTED_SAFE_FAILURE
}

model User {
  id                 String        @id @default(cuid())
  authProvider       AuthProvider?
  authProviderUserId String?
  email              String?       @unique
  name               String?
  status             UserStatus    @default(ACTIVE)
  country            String        @default("AU")
  timezone           String        @default("Australia/Brisbane")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  settings                     UserSettings?
  categories                   Category[]
  transactions                 Transaction[]
  importBatches                ImportBatch[]
  importRows                   ImportRow[]
  bankImportProfiles           BankImportProfile[]
  merchantProfiles             MerchantProfile[]
  merchantAliases              MerchantAlias[]
  merchantRules                MerchantRule[]
  properties                   Property[]
  loanAccounts                 LoanAccount[]
  loanRepayments               LoanRepayment[]
  loanReconciliationLinks      LoanReconciliationLink[]
  propertyTransactionLinks     PropertyTransactionLink[]
  propertyReportReviews        PropertyReportReview[]
  recurringItems               RecurringItem[]
  recurringSuggestionDismissals RecurringSuggestionDismissal[]
  categoryBudgets              CategoryBudget[]
  bulkOperations               BulkOperation[]
  bulkOperationItems           BulkOperationItem[]
  transferLinks                TransferLink[]
  auditEvents                  AuditEvent[]

  @@unique([authProvider, authProviderUserId])
}

model UserSettings {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  simpleMode              Boolean  @default(true)
  currency                String   @default("AUD")
  locale                  String   @default("en-AU")
  financialYearStartMonth Int      @default(7)
  featureFlags            Json     @default("{}")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id         String       @id @default(cuid())
  userId     String
  name       String
  type       CategoryType
  parentId   String?
  colour     String?
  icon       String?
  isSeeded   Boolean      @default(false)
  isArchived Boolean      @default(false)
  deletedAt  DateTime?
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent           Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]        @relation("CategoryTree")
  transactions     Transaction[]     @relation("TransactionCategory")
  importRows       ImportRow[]       @relation("ImportRowCategory")
  merchantProfiles MerchantProfile[] @relation("MerchantDefaultCategory")
  merchantRules    MerchantRule[]    @relation("MerchantRuleCategory")
  recurringItems   RecurringItem[]
  categoryBudgets       CategoryBudget[]
  bulkTargetOperations BulkOperation[] @relation("BulkOperationTargetCategory")

  @@unique([userId, name, type])
  @@index([userId, type])
  @@index([userId, parentId])
  @@index([userId, isArchived, deletedAt])
}

model Transaction {
  id                           String            @id @default(cuid())
  userId                       String
  categoryId                   String?
  importBatchId                String?
  merchantProfileId            String?
  type                         TransactionType
  source                       TransactionSource
  status                       TransactionStatus @default(ACTIVE)
  splitRole                    SplitRole         @default(NONE)
  parentTransactionId          String?
  amountCents                  Int
  date                         DateTime
  description                  String
  importedDescriptionSanitized String?
  merchantName                 String?
  notes                        String?
  csvMatchHint                 Boolean           @default(false)
  importFingerprint            String?
  duplicateKey                 String?
  reviewedAt                   DateTime?
  deletedAt                    DateTime?
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category                Category?                @relation("TransactionCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  importBatch             ImportBatch?             @relation("ImportBatchTransactions", fields: [importBatchId], references: [id], onDelete: SetNull)
  merchantProfile         MerchantProfile?         @relation("TransactionMerchantProfile", fields: [merchantProfileId], references: [id], onDelete: SetNull)
  parentTransaction       Transaction?             @relation("TransactionSplits", fields: [parentTransactionId], references: [id], onDelete: SetNull)
  splitChildren           Transaction[]            @relation("TransactionSplits")
  importRowsMatched       ImportRow[]              @relation("ImportRowMatchedTransaction")
  importRowsCommitted     ImportRow[]              @relation("ImportRowCommittedTransaction")
  loanReconciliationLinks LoanReconciliationLink[]
  propertyLink            PropertyTransactionLink?
  propertyReportReview    PropertyReportReview?
  bulkOperationItems       BulkOperationItem[]
  outgoingTransferLinks    TransferLink[]            @relation("OutgoingTransferTransaction")
  incomingTransferLinks    TransferLink[]            @relation("IncomingTransferTransaction")

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, importBatchId])
  @@index([userId, merchantProfileId])
  @@index([userId, parentTransactionId])
  @@index([userId, importFingerprint])
  @@index([userId, duplicateKey])
  @@index([userId, deletedAt])
}

model ImportBatch {
  id                       String            @id @default(cuid())
  userId                   String
  type                     ImportType        @default(TRANSACTION_CSV)
  status                   ImportBatchStatus @default(CREATED)
  bankImportProfileId      String?
  safeFileName             String?
  originalFileNameRedacted String?
  fileNameHash             String?
  fileSizeBytes            Int?
  rowCount                 Int               @default(0)
  parsedRowCount           Int               @default(0)
  privateFieldCount        Int               @default(0)
  importedCount            Int               @default(0)
  skippedCount             Int               @default(0)
  mergedCount              Int               @default(0)
  detectedBankName         String?
  detectedAccountType      String?
  mappingSummary           Json?
  excludedPrivateHeaders   String[]          @default([])
  warningCodes             String[]          @default([])
  createdAt                DateTime          @default(now())
  completedAt              DateTime?
  deletedAt                DateTime?
  updatedAt                DateTime          @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankImportProfile BankImportProfile? @relation("BankImportProfileBatches", fields: [bankImportProfileId], references: [id], onDelete: SetNull)
  transactions      Transaction[]      @relation("ImportBatchTransactions")
  importRows        ImportRow[]
  loanRepayments    LoanRepayment[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([userId, fileNameHash])
  @@index([userId, deletedAt])
}

model ImportRow {
  id                     String          @id @default(cuid())
  userId                 String
  importBatchId          String
  rowNumber              Int
  action                 ImportRowAction @default(UNDECIDED)
  status                 ImportRowStatus @default(NEEDS_REVIEW)
  mappedDate             DateTime?
  amountCents            Int?
  description            String?
  merchantName           String?
  categoryId             String?
  matchedTransactionId   String?
  committedTransactionId String?
  warningCodes           String[]        @default([])
  metadata               Json?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  importBatch          ImportBatch  @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  category             Category?    @relation("ImportRowCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  matchedTransaction   Transaction? @relation("ImportRowMatchedTransaction", fields: [matchedTransactionId], references: [id], onDelete: SetNull)
  committedTransaction Transaction? @relation("ImportRowCommittedTransaction", fields: [committedTransactionId], references: [id], onDelete: SetNull)

  @@unique([importBatchId, rowNumber])
  @@index([userId, importBatchId])
  @@index([userId, status])
  @@index([userId, action])
  @@index([userId, matchedTransactionId])
}

model BankImportProfile {
  id                    String   @id @default(cuid())
  userId                String
  displayName           String
  bankName              String?
  accountType           String?
  hasHeader             Boolean  @default(true)
  dateFormats           String[] @default([])
  columnMapping         Json
  ignoredHeaders        String[] @default([])
  privateHeaderPatterns String[] @default([])
  confidence            Int      @default(0)
  isUserConfirmed       Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  importBatches ImportBatch[] @relation("BankImportProfileBatches")

  @@unique([userId, displayName])
  @@index([userId, bankName])
}

model MerchantProfile {
  id                String    @id @default(cuid())
  userId            String
  name              String
  normalizedName    String
  defaultCategoryId String?
  isActive          Boolean   @default(true)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultCategory Category?       @relation("MerchantDefaultCategory", fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  aliases         MerchantAlias[] @relation("MerchantProfileAliases")
  rules           MerchantRule[]  @relation("MerchantProfileRules")
  transactions    Transaction[]   @relation("TransactionMerchantProfile")

  @@unique([userId, normalizedName])
  @@index([userId, defaultCategoryId])
  @@index([userId, isActive, deletedAt])
}

model MerchantAlias {
  id                String    @id @default(cuid())
  userId            String
  merchantProfileId String
  aliasName         String
  normalizedAlias   String
  isActive          Boolean   @default(true)
  deactivatedAt     DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantProfile MerchantProfile @relation("MerchantProfileAliases", fields: [merchantProfileId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedAlias])
  @@index([userId, merchantProfileId])
  @@index([userId, normalizedAlias])
  @@index([userId, isActive, deletedAt])
}

model MerchantRule {
  id                String           @id @default(cuid())
  userId            String
  merchantProfileId String?
  categoryId        String?
  type              MerchantRuleType
  pattern           String
  normalizedPattern String
  priority          Int              @default(100)
  isActive          Boolean          @default(true)
  deactivatedAt     DateTime?
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantProfile MerchantProfile? @relation("MerchantProfileRules", fields: [merchantProfileId], references: [id], onDelete: SetNull)
  category        Category?        @relation("MerchantRuleCategory", fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, type, isActive])
  @@index([userId, merchantProfileId])
  @@index([userId, categoryId])
  @@index([userId, normalizedPattern])
  @@index([userId, deletedAt])
}

model AuditEvent {
  id         String          @id @default(cuid())
  userId     String
  entityType AuditEntityType
  entityId   String?
  action     AuditAction
  metadata   Json?
  createdAt  DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, entityType, entityId])
}

model Property {
  id         String        @id @default(cuid())
  userId     String
  nickname   String
  usage      PropertyUsage
  isArchived Boolean       @default(false)
  archivedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanAccounts     LoanAccount[]
  transactionLinks PropertyTransactionLink[]
  reportReviews         PropertyReportReview[]
  bulkTargetOperations BulkOperation[] @relation("BulkOperationTargetProperty")

  @@unique([userId, nickname])
  @@index([userId, usage])
  @@index([userId, isArchived, deletedAt])
}

model LoanAccount {
  id                  String      @id @default(cuid())
  userId              String
  propertyId          String?
  nickname            String
  lenderName          String?
  purpose             LoanPurpose
  type                LoanType
  currentBalanceCents Int?
  balanceAsOf         DateTime?
  isArchived          Boolean     @default(false)
  archivedAt          DateTime?
  deletedAt           DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  repayments LoanRepayment[]

  @@unique([userId, nickname])
  @@index([userId, propertyId])
  @@index([userId, purpose, type])
  @@index([userId, isArchived, deletedAt])
}

model LoanRepayment {
  id                   String                   @id @default(cuid())
  userId               String
  loanAccountId        String
  importBatchId        String?
  repaymentDate        DateTime
  totalPaymentCents    Int
  principalCents       Int?
  interestCents        Int?
  feeCents             Int?
  balanceAfterCents    Int?
  source               LoanRepaymentSource
  reconciliationStatus LoanReconciliationStatus @default(UNMATCHED)
  isArchived           Boolean                  @default(false)
  archivedAt           DateTime?
  deletedAt            DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanAccount        LoanAccount             @relation(fields: [loanAccountId], references: [id], onDelete: Restrict)
  importBatch        ImportBatch?            @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  reconciliationLink LoanReconciliationLink?

  @@index([userId, loanAccountId, repaymentDate])
  @@index([userId, importBatchId])
  @@index([userId, reconciliationStatus])
  @@index([userId, isArchived, deletedAt])
}

model LoanReconciliationLink {
  id                  String                       @id @default(cuid())
  userId              String
  loanRepaymentId     String                       @unique
  transactionId       String
  confidence          LoanReconciliationConfidence
  amountVarianceCents Int
  dateDifferenceDays  Int
  method              LoanReconciliationLinkMethod
  reason              LoanReconciliationReason
  unlinkedAt          DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanRepayment LoanRepayment @relation(fields: [loanRepaymentId], references: [id], onDelete: Restrict)
  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([userId, transactionId])
  @@index([userId, unlinkedAt])
}

model PropertyTransactionLink {
  id            String    @id @default(cuid())
  userId        String
  transactionId String    @unique
  propertyId    String
  unlinkedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@index([userId, propertyId, unlinkedAt])
  @@index([userId, unlinkedAt])
}

model PropertyReportReview {
  id             String                       @id @default(cuid())
  userId         String
  propertyId     String
  transactionId  String                       @unique
  classification PropertyRecordClassification
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([userId, propertyId, classification])
  @@index([userId, classification])
}

model RecurringItem {
  id                  String              @id @default(cuid())
  userId              String
  categoryId          String?
  label               String
  transactionType     TransactionType
  expectedAmountCents Int?
  cadence             RecurringCadence
  nextExpectedDate    DateTime?
  status              RecurringItemStatus @default(ACTIVE)
  archivedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, categoryId])
  @@index([userId, cadence])
}

model RecurringSuggestionDismissal {
  id            String   @id @default(cuid())
  userId        String
  suggestionKey String
  dismissedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, suggestionKey])
  @@index([userId, dismissedAt])
}

model CategoryBudget {
  id          String       @id @default(cuid())
  userId      String
  categoryId  String
  amountCents Int
  period      BudgetPeriod @default(MONTHLY)
  status      BudgetStatus @default(ACTIVE)
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, categoryId])
  @@index([userId, period, status])
  @@index([userId, categoryId, period, status])
}


model BulkOperation {
  id               String              @id @default(cuid())
  userId           String
  type             BulkOperationType
  status           BulkOperationStatus @default(RUNNING)
  targetCategoryId String?
  targetPropertyId String?
  requestedCount   Int                 @default(0)
  appliedCount     Int                 @default(0)
  skippedCount     Int                 @default(0)
  failedCount      Int                 @default(0)
  undoBlockedCount Int                 @default(0)
  createdAt        DateTime            @default(now())
  completedAt      DateTime?
  undoExpiresAt    DateTime?
  revertedAt       DateTime?
  updatedAt        DateTime            @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetCategory Category?           @relation("BulkOperationTargetCategory", fields: [targetCategoryId], references: [id], onDelete: SetNull)
  targetProperty Property?           @relation("BulkOperationTargetProperty", fields: [targetPropertyId], references: [id], onDelete: SetNull)
  items          BulkOperationItem[]

  @@index([userId, status, createdAt])
  @@index([userId, type, createdAt])
  @@index([targetCategoryId])
  @@index([targetPropertyId])
}

model BulkOperationItem {
  id                          String                  @id @default(cuid())
  userId                      String
  operationId                 String
  transactionId               String
  status                      BulkOperationItemStatus
  reason                      BulkOperationReason?
  beforeCategoryId            String?
  afterCategoryId             String?
  beforePropertyId            String?
  afterPropertyId             String?
  beforeTransactionUpdatedAt  DateTime?
  appliedTransactionUpdatedAt DateTime?
  revertedAt                  DateTime?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation   BulkOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  transaction Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([operationId, transactionId])
  @@index([userId, status, createdAt])
  @@index([operationId, status])
  @@index([transactionId, createdAt])
}


model TransferLink {
  id                    String    @id @default(cuid())
  userId                String
  outgoingTransactionId String
  incomingTransactionId String
  confirmedAt           DateTime  @default(now())
  unlinkedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoingTransaction Transaction @relation("OutgoingTransferTransaction", fields: [outgoingTransactionId], references: [id], onDelete: Restrict)
  incomingTransaction Transaction @relation("IncomingTransferTransaction", fields: [incomingTransactionId], references: [id], onDelete: Restrict)

  @@index([userId, unlinkedAt, createdAt])
  @@index([userId, outgoingTransactionId, unlinkedAt])
  @@index([userId, incomingTransactionId, unlinkedAt])
}
